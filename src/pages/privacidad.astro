---
import TelectrichLayout from '~/layouts/TelectrichLayout.astro';

const metadata = {
  title: 'Política de privacidad',
  description: 'Cómo Telectrich trata los datos que recibe por el formulario de contacto y el uso de cookies.',
  ignoreTitleTemplate: true,
};

const indice = [
  { id: 'responsable', texto: 'Responsable' },
  { id: 'datos', texto: 'Datos que recibimos' },
  { id: 'uso', texto: 'Para qué los usamos' },
  { id: 'proveedores', texto: 'Proveedores' },
  { id: 'derechos', texto: 'Tus derechos' },
  { id: 'cookies', texto: 'Cookies' },
];
---

<TelectrichLayout metadata={metadata} bar={false}>
  <section class="band band--fondo band--sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h1 class="priv-h1">Política de privacidad</h1>
    </div>
  </section>

  <section class="band band--blanco">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 priv-grid">
      <nav class="priv-indice" aria-label="Índice">
        <h2 class="priv-indice-titulo">Índice</h2>
        <ul>
          {
            indice.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.texto}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <article class="priv-articulo">
        <p class="priv-borrador">
          Texto provisional de la maqueta. El aviso definitivo lo redacta la tarea T10 y el riesgo de la Ley 21.719
          sigue declarado, sin revisión legal.
        </p>

        <section id="responsable">
          <h2>Responsable</h2>
          <p>
            AT Ingeniería SpA (RUT 76.303.133-0), a través de su división Telectrich. Taller en Parcelación Victoria de
            Viluco, Buin, Región Metropolitana. Contacto: ventas@atingenieria.com · +56 9 3593 5595.
          </p>
        </section>

        <section id="datos">
          <h2>Datos que recibimos</h2>
          <p>Al enviar el formulario de cotización recibimos:</p>
          <ul>
            <li>Nombre, correo y área de desempeño del tablero (obligatorios).</li>
            <li>Gama (alta, media o económica), obligatoria.</li>
            <li>Teléfono, empresa, ubicación del tablero y mensaje (opcionales).</li>
            <li>Un archivo adjunto de hasta 10 MB (opcional).</li>
          </ul>
          <p>Si nos escribes por WhatsApp, solo medimos el clic en el enlace. No recolectamos el contenido del chat.</p>
        </section>

        <section id="uso">
          <h2>Para qué los usamos</h2>
          <p>Para responder tu consulta y preparar la cotización. No enviamos boletines ni vendemos tus datos.</p>
        </section>

        <section id="proveedores">
          <h2>Proveedores</h2>
          <p>
            Usamos servicios de terceros para operar el sitio: hosting, envío de correo, protección contra spam y
            medición de uso. El detalle por proveedor se completa en el aviso definitivo.
          </p>
        </section>

        <section id="derechos">
          <h2>Tus derechos</h2>
          <p>Puedes pedir acceso, rectificación o eliminación de tus datos escribiendo a ventas@atingenieria.com.</p>
        </section>

        <section id="cookies">
          <h2>Cookies</h2>
          <p>
            Medimos el uso del sitio solo si aceptas las cookies de medición. Puedes cambiar tu elección cuando quieras.
          </p>
          <p class="priv-acciones">
            <button type="button" class="priv-btn-cookies" data-open-ck> Preferencias de cookies </button>
          </p>
        </section>
      </article>
    </div>
  </section>
</TelectrichLayout>

<script>
  import { initFormulario } from '~/scripts/formulario';
  const start = () => initFormulario();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
  document.addEventListener('astro:page-load', start);
</script>

<style>
  /* Sin barra inferior ni flotante; sí banner y footer */
  :global(#barra-fija),
  :global(#whatsapp-flotante) {
    display: none !important;
  }

  .priv-h1 {
    color: var(--color-noche);
    font-weight: 600;
    letter-spacing: -0.024em;
    line-height: 1.05;
    font-size: clamp(2rem, 1.1rem + 3.4vw, 3.5rem);
    max-width: 20ch;
    margin: 0;
  }

  .priv-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .priv-grid {
      grid-template-columns: 14rem 1fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .priv-indice {
    align-self: start;
  }

  @media (min-width: 1024px) {
    .priv-indice {
      position: sticky;
      top: calc(64px + 1.5rem);
      max-height: calc(100vh - 64px - 3rem);
      overflow-y: auto;
    }
  }

  .priv-indice-titulo {
    color: var(--color-cuerpo);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    margin: 0 0 0.75rem;
  }

  .priv-indice ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .priv-indice a {
    color: var(--color-noche);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.4;
    border-left: 2px solid transparent;
    padding-left: 0.75rem;
    margin-left: -0.75rem;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .priv-indice a:hover,
  .priv-indice a:focus-visible {
    color: var(--color-noche-2);
    border-left-color: var(--color-acento);
    outline: none;
  }

  .priv-articulo {
    max-width: 75ch;
    color: var(--color-noche);
    display: grid;
    gap: 1.75rem;
  }

  .priv-articulo section {
    display: grid;
    gap: 0.75rem;
  }

  .priv-articulo h2 {
    color: var(--color-noche);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    margin: 0;
    scroll-margin-top: calc(64px + 1rem);
  }

  .priv-articulo p {
    margin: 0;
    line-height: 1.6;
    font-size: 1rem;
    color: var(--color-noche);
  }

  .priv-articulo ul {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.375rem;
    line-height: 1.6;
  }

  .priv-articulo ul li::marker {
    color: var(--color-acento);
  }

  .priv-borrador {
    background-color: var(--color-fondo);
    border: 1px solid var(--color-borde);
    border-left: 3px solid var(--color-acento);
    border-radius: 6px;
    padding: 0.875rem 1rem;
    color: var(--color-cuerpo);
    font-size: 0.875rem;
    font-style: italic;
  }

  .priv-acciones {
    margin-top: 0.5rem;
  }

  .priv-btn-cookies {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 1.25rem;
    background-color: var(--color-noche);
    color: #ffffff;
    border: 0;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .priv-btn-cookies:hover {
    background-color: var(--color-noche-2);
  }

  .priv-btn-cookies:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(21, 44, 61, 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .priv-indice a,
    .priv-btn-cookies {
      transition: none;
    }
  }
</style>

<script>
  import '~/scripts/hero-carrusel';

  declare global {
    interface Window {
      __tableroHeightHandled?: boolean;
    }
  }

  // Unifilar animation: one-shot per session
  (function () {
    const root = document.documentElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let played = false;
    try {
      played = sessionStorage.getItem('u-played') === '1';
    } catch (e) {
      played = false;
    }
    if (!reduce && !played) {
      root.classList.add('u-play');
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          root.classList.add('u-go');
          try {
            sessionStorage.setItem('u-played', '1');
          } catch (e) {
            /* ignore */
          }
          setTimeout(() => root.classList.remove('u-play'), 3000);
        })
      );
    }
  })();

  // Tablero iframe height sync (from prototipo)
  window.addEventListener('message', (e: MessageEvent) => {
    const data = e.data as { tablero?: string; v?: number } | null;
    if (!data || data.tablero !== 'h') return;
    const frame = document.getElementById('tablero') as HTMLIFrameElement | null;
    if (frame && typeof data.v === 'number') frame.style.height = `${data.v}px`;
  });
</script>


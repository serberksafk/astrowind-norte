---
import TelectrichLayout from '~/layouts/TelectrichLayout.astro';
import TarjetaSolucion from '~/components/telectrich/TarjetaSolucion.astro';
import Marcas from '~/components/telectrich/Marcas.astro';
import Badges from '~/components/telectrich/Badges.astro';
import Riel from '~/components/telectrich/Riel.astro';
import BandaFinal from '~/components/telectrich/BandaFinal.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CONTACTO } from '~/data/sitio';

import hero1 from '~/assets/hero/hero-1.jpg';
import hero2 from '~/assets/hero/hero-2.jpg';
import hero3 from '~/assets/hero/hero-3.jpg';
import hero4 from '~/assets/hero/hero-4.jpg';
import hero5 from '~/assets/hero/hero-5.jpg';
import hero6 from '~/assets/hero/hero-6.jpg';
import plcS71200 from '~/assets/img/plc-s7-1200.jpg';
import marcajeFrente from '~/assets/img/marcaje-frente.jpg';

const metadata = {
  title: 'Fabricación de tableros eléctricos industriales | Telectrich',
  description:
    'Fabricación, armado e integración de tableros eléctricos industriales a medida en Chile. Diseño alineado con RIC N°2 e IEC 61439 y pruebas FAT.',
};

interface Slide {
  src: ImageMetadata;
  alt: string;
  cap: string;
  eager?: boolean;
}

const slidesHero: Slide[] = [
  {
    src: hero1,
    alt: 'Interruptores y protecciones de un tablero de fuerza con cableado identificado',
    cap: 'FUERZA',
    eager: true,
  },
  {
    src: hero2,
    alt: 'Fila de PLC y bornes rotulados dentro de un tablero industrial',
    cap: 'CONTROL',
  },
  {
    src: hero3,
    alt: 'Módulos de entradas y salidas de un tablero de control',
    cap: 'CONTROL',
  },
  {
    src: hero4,
    alt: 'Cable naranja y borneras de un tablero de control',
    cap: 'CABLEADO',
  },
  {
    src: hero5,
    alt: 'Puerta de un tablero con pantalla HMI y botonera',
    cap: 'SUPERVISIÓN',
  },
  {
    src: hero6,
    alt: 'Primer plano de un PLC y sus módulos de entradas y salidas',
    cap: 'PLC',
  },
];

const whatsappUrl = CONTACTO.whatsapp;

interface FaqItem {
  pregunta: string;
  respuestaHtml: string;
}

const faqs: FaqItem[] = [
  {
    pregunta: '¿Los tableros cumplen la normativa chilena?',
    respuestaHtml:
      'Todos nuestros diseños están alineados con el Pliego Técnico RIC N°2 de la SEC y con la serie IEC 61439. El estándar de diseño que ofrecemos es igual o superior al normativo.',
  },
  {
    pregunta: '¿Incluyen pruebas FAT?',
    respuestaHtml:
      'Toda oferta incluye la prueba de aceptación en fábrica antes del despacho. La prueba en terreno, con el equipo instalado, se suma solo si el proyecto la requiere. <a href="/pruebas-fat-sat-y-comisionamiento/" class="link-noche">Ver servicios de terreno</a>.',
  },
  {
    pregunta: '¿Qué documentación entregan con el tablero?',
    respuestaHtml:
      'Entregamos la documentación completa del proyecto: diseño (layout y diagrama eléctrico), protocolo de pruebas FAT y memorias de cálculo cuando aplique.',
  },
  {
    pregunta: '¿Con qué marcas trabajan?',
    respuestaHtml:
      'Integramos componentes de marcas premium, elegidos según la especificación de cada proyecto.',
  },
  {
    pregunta: '¿Qué garantía tienen los trabajos?',
    respuestaHtml: 'La garantía es de 6 meses en los equipos electrónicos y de 1 año en la integración realizada.',
  },
  {
    pregunta: '¿Hacen pruebas y puesta en marcha en terreno fuera de la Región Metropolitana?',
    respuestaHtml:
      'Sí. Hacemos pruebas en terreno donde el proyecto lo requiera, sin límite geográfico. El taller está en Buin, Región Metropolitana.',
  },
  {
    pregunta: '¿Cuánto demoran en responder y cotizar?',
    respuestaHtml:
      'Respondemos tu consulta en 1 día y entregamos la cotización en 48 horas. El formulario admite adjuntos, como planos o el listado de cargas. <a href="/contacto/" class="link-noche">Solicitar cotización</a>.',
  },
];

const pasosProceso = [
  { titulo: 'Diseño', descripcion: 'Alineado con la normativa y el estándar de cada cliente.' },
  { titulo: 'Fabricación', descripcion: 'En nuestro taller de Buin.' },
  { titulo: 'Pruebas de fábrica', descripcion: 'FAT antes del despacho.' },
  { titulo: 'Comisionamiento', descripcion: 'En terreno, con el equipo instalado.' },
  { titulo: 'Puesta en marcha', descripcion: 'Arranque coordinado y acompañamiento inicial.' },
];
---

<TelectrichLayout metadata={metadata}>
  <section class="band band--noche band--hero hero hero--full" aria-labelledby="hero-h1" data-cta-watch>
    <div class="hero-slides" data-hero-carousel aria-roledescription="carrusel" aria-label="Tableros fabricados por Telectrich">
      {slidesHero.map((s, i) => (
        <figure class={`sl ${i === 0 ? 'on' : ''}`} data-hero-slide data-cap={s.cap}>
          <Image
            src={s.src}
            alt={s.alt}
            width={1920}
            height={1080}
            class="hero-slide-img"
            loading={s.eager ? 'eager' : 'lazy'}
            fetchpriority={s.eager ? 'high' : 'auto'}
            decoding="async"
          />
        </figure>
      ))}
    </div>

    <div class="hero-bg" aria-hidden="true">
      <div class="unifilar">
        <svg viewBox="0 0 1200 540" aria-hidden="true" focusable="false">
          <circle class="u-fill" pathLength="1" cx="100" cy="52" r="20" style="--dl:0s"></circle>
          <path class="u-line" pathLength="1" d="M89 52q5.500-9 11 0t11 0" style="--dl:0.1s;--d:400ms"></path>
          <path class="u-line" pathLength="1" d="M100 72V124" style="--dl:0.1s;--d:400ms"></path>
          <rect class="u-fill" pathLength="1" x="86" y="124" width="28" height="40" rx="3" style="--dl:0.25s;--d:600ms"></rect>
          <path class="u-line" pathLength="1" d="M92 158 108 130" style="--dl:0.35s;--d:300ms"></path>
          <path class="u-line" pathLength="1" d="M100 164V240" style="--dl:0.3s;--d:400ms"></path>
          <text class="u-text" x="150" y="148" text-anchor="middle" style="--dl:0.5s">Q1</text>
          <path class="u-line u-bus" pathLength="1" d="M100 240H1100" style="--dl:0.6s;--d:800ms"></path>
          <path class="u-line" pathLength="1" d="M230 240V500" style="--dl:0.9s;--d:600ms"></path>
          <path class="u-line" pathLength="1" d="M500 240V500" style="--dl:1.02s;--d:600ms"></path>
          <path class="u-line" pathLength="1" d="M770 240V500" style="--dl:1.1400000000000001s;--d:600ms"></path>
          <path class="u-line" pathLength="1" d="M1040 240V500" style="--dl:1.26s;--d:600ms"></path>
          <rect class="u-fill" pathLength="1" x="216" y="292" width="28" height="46" rx="3" style="--dl:1s;--d:600ms"></rect>
          <path class="u-line" pathLength="1" d="M222 332 238 298" style="--dl:1.1s;--d:300ms"></path>
          <circle class="u-fill" pathLength="1" cx="230" cy="430" r="26" style="--dl:1.15s"></circle>
          <text class="u-text" x="230" y="436" text-anchor="middle" style="--dl:1.2s">M</text>
          <rect class="u-fill" pathLength="1" x="444" y="296" width="112" height="80" rx="3" style="--dl:1.1s;--d:600ms"></rect>
          <rect class="u-fill" pathLength="1" x="458" y="312" width="24" height="16" rx="3" style="--dl:1.2s;--d:600ms"></rect>
          <rect class="u-fill" pathLength="1" x="490" y="312" width="24" height="16" rx="3" style="--dl:1.2s;--d:600ms"></rect>
          <rect class="u-fill" pathLength="1" x="522" y="312" width="24" height="16" rx="3" style="--dl:1.2s;--d:600ms"></rect>
          <path class="u-line" pathLength="1" d="M458 352H542" style="--dl:1.25s;--d:300ms"></path>
          <rect class="u-fill" pathLength="1" x="708" y="296" width="124" height="84" rx="3" style="--dl:1.2s;--d:600ms"></rect>
          <rect class="u-fill" pathLength="1" x="720" y="306" width="100" height="56" rx="3" style="--dl:1.3s;--d:600ms"></rect>
          <path class="u-line" pathLength="1" d="M750 392H790" style="--dl:1.35s;--d:300ms"></path>
          <rect class="u-fill" pathLength="1" x="974" y="300" width="132" height="46" rx="3" style="--dl:1.3s;--d:600ms"></rect>
          <rect class="u-fill" pathLength="1" x="990" y="314" width="18" height="18" rx="3" style="--dl:1.4s;--d:600ms"></rect>
          <rect class="u-fill" pathLength="1" x="1018" y="314" width="18" height="18" rx="3" style="--dl:1.4s;--d:600ms"></rect>
          <rect class="u-fill" pathLength="1" x="1046" y="314" width="18" height="18" rx="3" style="--dl:1.4s;--d:600ms"></rect>
          <rect class="u-fill" pathLength="1" x="1074" y="314" width="18" height="18" rx="3" style="--dl:1.4s;--d:600ms"></rect>
          <path class="u-line" pathLength="1" d="M1000 346V440M1040 346V460M1080 346V440" style="--dl:1.4s;--d:400ms"></path>
          <text class="u-text" x="230" y="530" text-anchor="middle" style="--dl:1.5s">01 FUERZA</text>
          <text class="u-text" x="500" y="530" text-anchor="middle" style="--dl:1.55s">02 CONTROL</text>
          <text class="u-text" x="770" y="530" text-anchor="middle" style="--dl:1.6s">03 SUPERVISIÓN</text>
          <text class="u-text" x="1040" y="530" text-anchor="middle" style="--dl:1.65s">04 COMUNICACIONES</text>
          <path class="u-pulse" pathLength="1" d="M100 240H1100"></path>
          <path class="u-pulse p1" pathLength="1" d="M230 240V500"></path>
          <path class="u-pulse p2" pathLength="1" d="M500 240V500"></path>
          <path class="u-pulse p3" pathLength="1" d="M770 240V500"></path>
          <path class="u-pulse p4" pathLength="1" d="M1040 240V500"></path>
        </svg>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 class="h1" id="hero-h1">Fabricación de tableros eléctricos industriales</h1>
          <p class="lead">
            Fuerza, control y <em class="acento">precisión</em>. Tableros eléctricos y sistemas de control que responden
            a las exigencias de tu proyecto. Desde el diseño hasta la puesta en marcha en terreno.
          </p>
          <div class="btn-row">
            <a href="/contacto/" class="btn-ctaprinc" data-wa="hero-cta" data-wa-ubicacion="hero">Conversemos</a>
            <a
              href={whatsappUrl}
              class="btn-ctaout"
              data-wa="hero-cta"
              data-wa-ubicacion="hero"
              aria-label="Conversar por WhatsApp"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
              </svg>
              WhatsApp
            </a>
          </div>
        </div>
        <div class="hero-photo">
          <figure>
            <Image
              src={plcS71200}
              alt="PLC Siemens S7-1200 con cableado identificado en un tablero de control"
              width={960}
              height={1200}
              class="hero-photo-img"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      </div>
    </div>

    <div class="wrap hero-ctlwrap">
      <div class="hero-ctl">
        <span class="tag" data-cap-out>FUERZA</span>
        <div class="hero-dots" role="group" aria-label="Elegir imagen">
          {slidesHero.map((s, i) => (
            <button
              type="button"
              class="hero-dot"
              data-hero-dot={i}
              aria-label={`Imagen ${i + 1} de ${slidesHero.length}: ${s.cap}`}
              aria-current={i === 0 ? 'true' : 'false'}
            >
              <span></span>
            </button>
          ))}
        </div>
        <button
          type="button"
          class="hero-pause"
          data-hero-pause
          aria-pressed="false"
          aria-label="Pausar el carrusel"
        >
          <svg class="i-pause" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M4 3h3v10H4zM9 3h3v10H9z"></path>
          </svg>
          <svg class="i-play" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M5 3.200v9.600L13 8z"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <section class="band band--blanco" aria-labelledby="respaldo">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="split">
        <div class="a prose">
          <h2 class="h2" id="respaldo">
            Rigor técnico, <mark class="acento">respaldo</mark> de AT Ingeniería
          </h2>
          <p class="prose-p">
            Con trayectoria desde 2013, respaldados por AT Ingeniería SpA, entregamos soluciones de ingeniería
            eléctrica donde el rigor técnico es la norma. No solo somos integradores de gabinetes eléctricos:
            acompañamos cada proyecto en todas sus etapas, desde el diseño hasta el pre-comisionamiento, el
            comisionamiento y la puesta en marcha en terreno.
          </p>
          <p class="inline-list">
            Minería y metales ·
            <a href="#industrias" class="inline-link">Alimentos y bebidas</a> ·
            <a href="#industrias" class="inline-link">Energía e infraestructura</a> ·
            <a href="#industrias" class="inline-link">Manufactura industrial</a>
          </p>
        </div>
        <div class="b">
          <div class="big-year">
            <small>desde</small>
            2013
            <i aria-hidden="true"></i>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--fondo" aria-labelledby="solus">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="sec-head">
        <h2 class="h2" id="solus">Tableros eléctricos industriales a medida</h2>
        <p class="lead">
          Diseñamos e integramos tableros eléctricos industriales a medida, optimizados para la continuidad operacional
          y la mantenibilidad.
        </p>
      </div>
      <div class="sol-grid">
        <div class="sol-card-wrap">
          <TarjetaSolucion
            solucion={{
              numero: '01',
              nombre: 'Tableros de fuerza',
              resumen:
                'Distribución y alimentación de cargas con protecciones y envolventes adaptados al entorno.',
              ruta: '/soluciones/tableros-de-fuerza/',
              foto: 'distribucion-schneider',
              alt: 'Tablero de distribución con interruptores y protecciones en riel',
            }}
          />
        </div>
        <div class="sol-card-wrap">
          <TarjetaSolucion
            solucion={{
              numero: '02',
              nombre: 'Tableros de control',
              resumen:
                'Integración de PLC, gestión de señales y automatización industrial diseñada para facilitar la escalabilidad.',
              ruta: '/soluciones/tableros-de-control/',
              foto: 'control-abb-interior',
              alt: 'Interior de un tablero de control con PLC y cableado ordenado',
            }}
          />
        </div>
        <div class="sol-card-wrap">
          <TarjetaSolucion
            solucion={{
              numero: '03',
              nombre: 'Supervisión HMI',
              resumen:
                'Interfaces HMI para visualizar estados, gestionar alarmas y comandar la operación.',
              ruta: '/soluciones/supervision-hmi/',
              foto: 'hmi-nema4x',
              alt: 'Puerta de un tablero con pantalla HMI y botonera',
            }}
          />
        </div>
        <div class="sol-card-wrap">
          <TarjetaSolucion
            solucion={{
              numero: '04',
              nombre: 'Comunicaciones industriales',
              resumen:
                'Redes de campo, enlaces Ethernet y fibra óptica para conectar control y supervisión.',
              ruta: '/soluciones/comunicacion-industrial/',
              foto: 'switch-emerson',
              alt: 'Switch industrial montado en un tablero de comunicaciones',
            }}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="band band--noche" aria-labelledby="tab-t">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="sec-head">
        <h2 class="h2" id="tab-t">Así se arma un tablero de fuerza y control</h2>
        <p class="lead">
          Del gabinete vacío a la energización, en el orden en que se hace: riel y canaleta, protecciones, PLC, cableado
          con marcaje, puerta con HMI.
        </p>
      </div>
      <iframe
        id="tablero"
        class="tablero-frame"
        src="/tablero/tablero-armado.html?embed=1"
        title="Animación: armado de un tablero eléctrico en siete pasos"
        loading="lazy"
        style="width:100%;border:0;height:820px;border-radius:6px;background:#101F2C;"
      ></iframe>
      <p class="tablero-note">Ilustración esquemática. No representa un proyecto específico.</p>
    </div>
  </section>

  <section class="band band--blanco" aria-labelledby="marcas-t">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="sec-head">
        <h2 class="h2" id="marcas-t">Marcas que integramos</h2>
      </div>
      <Marcas />
      <p class="brands-note">Integramos componentes de estas marcas según la especificación de cada proyecto.</p>
    </div>
  </section>

  <section class="band band--noche" aria-labelledby="norm-t">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="norm-grid">
        <div class="a">
          <h2 class="h2" id="norm-t">
            Normativa y pruebas <mark class="acento">sin atajos</mark>
          </h2>
          <p class="lead">
            Todos nuestros diseños están alineados con el Pliego Técnico RIC N°2 (SEC Chile) y la serie IEC 61439,
            según normas nacionales, internacionales y el estándar constructivo de cada cliente.
          </p>
          <Badges normas={['RIC N°2', 'IEC 61439', 'FAT', 'IFAT', 'SAT', 'CAT']} />
          <p class="norm-extra">
            El ciclo de pruebas incluye FAT (prueba de aceptación en fábrica), IFAT, SAT (prueba de aceptación en
            terreno) y CAT.
          </p>
          <a class="link-arrow" href="/pruebas-fat-sat-y-comisionamiento/">
            Conoce cómo desarrollamos las pruebas en nuestra fábrica
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8h10M9 4l4 4-4 4"></path>
            </svg>
          </a>
        </div>
        <div class="b">
          <figure class="norm-photo">
            <Image
              src={marcajeFrente}
              alt="Frente de un tablero con marcaje de cables y rótulos"
              width={1400}
              height={1866}
              class="norm-photo-img"
              loading="lazy"
            />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--fondo" aria-labelledby="proc-t">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="sec-head">
        <h2 class="h2" id="proc-t">Del diseño a la puesta en marcha</h2>
        <p class="lead">
          Cada proyecto sigue la misma secuencia, alineada con RIC N°2, IEC 61439 y el estándar constructivo de cada
          cliente.
        </p>
      </div>
      <Riel pasos={pasosProceso} />
      <p class="link-row">
        <a class="link-arrow" href="/empresa/">
          Ver cómo trabajamos
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 8h10M9 4l4 4-4 4"></path>
          </svg>
        </a>
        <a class="link-arrow" href="/pruebas-fat-sat-y-comisionamiento/">
          Servicios de terreno
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 8h10M9 4l4 4-4 4"></path>
          </svg>
        </a>
      </p>
    </div>
  </section>

  <section class="band band--blanco" aria-labelledby="faq-t">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="sec-head">
        <h2 class="h2" id="faq-t">Preguntas frecuentes sobre tableros eléctricos industriales</h2>

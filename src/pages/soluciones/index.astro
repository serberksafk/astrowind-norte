---
import TelectrichLayout from '~/layouts/TelectrichLayout.astro';
import BandaFinal from '~/components/telectrich/BandaFinal.astro';
import { SOLUCIONES } from '~/data/sitio';
import { Image } from 'astro:assets';
import distSchneider from '~/assets/img/distribucion-schneider.jpg';
import controlAbb from '~/assets/img/control-abb-interior.jpg';
import hmiNema from '~/assets/img/hmi-nema4x.jpg';
import switchEmerson from '~/assets/img/switch-emerson.jpg';

const metadata = {
  title: 'Soluciones en tableros eléctricos industriales | Telectrich',
  description:
    'Tableros de fuerza, control, supervisión HMI y comunicación industrial. Diseño alineado con RIC N°2 e IEC 61439, con FAT en toda oferta.',
};

const fotos: Record<string, typeof distSchneider> = {
  'distribucion-schneider': distSchneider,
  'control-abb-interior': controlAbb,
  'hmi-nema4x': hmiNema,
  'switch-emerson': switchEmerson,
};

const posicionPorFoto: Record<string, string> = {
  'distribucion-schneider': '50% 40%',
  'control-abb-interior': '50% 45%',
  'hmi-nema4x': '50% 38%',
  'switch-emerson': '50% 40%',
};

const fotoPorSolucion: Record<string, string> = {
  '/soluciones/tableros-de-fuerza/': 'distribucion-schneider',
  '/soluciones/tableros-de-control/': 'control-abb-interior',
  '/soluciones/supervision-hmi/': 'hmi-nema4x',
  '/soluciones/comunicacion-industrial/': 'switch-emerson',
};

const altPorFoto: Record<string, string> = {
  'distribucion-schneider': 'Tablero de distribución con interruptores y protecciones en riel',
  'control-abb-interior': 'Interior de un tablero de control con PLC y cableado ordenado',
  'hmi-nema4x': 'Puerta de un tablero con pantalla HMI y botonera',
  'switch-emerson': 'Switch industrial montado en un tablero de comunicaciones',
};

const dimPorFoto: Record<string, { w: number; h: number }> = {
  'distribucion-schneider': { w: 1000, h: 750 },
  'control-abb-interior': { w: 1000, h: 750 },
  'hmi-nema4x': { w: 1000, h: 750 },
  'switch-emerson': { w: 1000, h: 750 },
};

const vinyetasPorSolucion: Record<string, string[]> = {
  '/soluciones/tableros-de-fuerza/': [
    'TDA y TDF para distribución de alumbrado y fuerza',
    'Protecciones y envolventes según el entorno',
    'Alimentación redundante para procesos críticos',
  ],
  '/soluciones/tableros-de-control/': [
    'Integración de PLC y módulos I/O',
    'Programación de la lógica de control',
    'Etiquetado y orden interno pensado para la mantenibilidad',
  ],
  '/soluciones/supervision-hmi/': [
    'Visualización de estados y variables',
    'Panel de operador HMI',
    'Gestión y priorización de alarmas',
  ],
  '/soluciones/comunicacion-industrial/': [
    'Switches industriales y enlaces',
    'Ethernet industrial y fibra óptica',
    'Verificación de comunicaciones',
  ],
};
---

<TelectrichLayout metadata={metadata}>
  <section class="band band--canaleta sol-hero hub-hero" aria-labelledby="hero-h1" data-cta-watch>
    <div class="sol-hero-bg" aria-hidden="true">
      <svg class="sol-unifilar" viewBox="0 0 1200 540" focusable="false" data-ramal-lit="0">
        <circle class="u-fill" pathLength="1" cx="100" cy="52" r="20" style="--dl:0s"></circle>
        <path class="u-line" pathLength="1" d="M89 52q5.500-9 11 0t11 0" style="--dl:0.1s;--d:400ms"></path>
        <path class="u-line" pathLength="1" d="M100 72V124" style="--dl:0.1s;--d:400ms"></path>
        <rect class="u-fill" pathLength="1" x="86" y="124" width="28" height="40" rx="3" style="--dl:0.25s;--d:600ms"
        ></rect>
        <path class="u-line" pathLength="1" d="M92 158 108 130" style="--dl:0.35s;--d:300ms"></path>
        <path class="u-line" pathLength="1" d="M100 164V240" style="--dl:0.3s;--d:400ms"></path>
        <text class="u-text" x="150" y="148" text-anchor="middle" style="--dl:0.5s">Q1</text>
        <path class="u-line u-bus" pathLength="1" d="M100 240H1100" style="--dl:0.6s;--d:800ms"></path>
        <path class="u-line" data-ramal="1" pathLength="1" d="M230 240V500" style="--dl:0.9s;--d:600ms"></path>
        <path class="u-line" data-ramal="2" pathLength="1" d="M500 240V500" style="--dl:1.02s;--d:600ms"></path>
        <path class="u-line" data-ramal="3" pathLength="1" d="M770 240V500" style="--dl:1.1400000000000001s;--d:600ms"
        ></path>
        <path class="u-line" data-ramal="4" pathLength="1" d="M1040 240V500" style="--dl:1.26s;--d:600ms"></path>
        <rect
          class="u-fill"
          data-ramal="1"
          pathLength="1"
          x="216"
          y="292"
          width="28"
          height="46"
          rx="3"
          style="--dl:1s;--d:600ms"></rect>
        <path class="u-line" data-ramal="1" pathLength="1" d="M222 332 238 298" style="--dl:1.1s;--d:300ms"></path>
        <circle class="u-fill" data-ramal="1" pathLength="1" cx="230" cy="430" r="26" style="--dl:1.15s"></circle>
        <text class="u-text" data-ramal="1" x="230" y="436" text-anchor="middle" style="--dl:1.2s">M</text>
        <rect
          class="u-fill"
          data-ramal="2"
          pathLength="1"
          x="444"
          y="296"
          width="112"
          height="80"
          rx="3"
          style="--dl:1.1s;--d:600ms"></rect>
        <rect
          class="u-fill"
          data-ramal="2"
          pathLength="1"
          x="458"
          y="312"
          width="24"
          height="16"
          rx="3"
          style="--dl:1.2s;--d:600ms"></rect>
        <rect
          class="u-fill"
          data-ramal="2"
          pathLength="1"
          x="490"
          y="312"
          width="24"
          height="16"
          rx="3"
          style="--dl:1.2s;--d:600ms"></rect>
        <rect
          class="u-fill"
          data-ramal="2"
          pathLength="1"
          x="522"
          y="312"
          width="24"
          height="16"
          rx="3"
          style="--dl:1.2s;--d:600ms"></rect>
        <path class="u-line" data-ramal="2" pathLength="1" d="M458 352H542" style="--dl:1.25s;--d:300ms"></path>
        <rect
          class="u-fill"
          data-ramal="3"
          pathLength="1"
          x="708"
          y="296"
          width="124"
          height="84"
          rx="3"
          style="--dl:1.2s;--d:600ms"></rect>
        <rect
          class="u-fill"
          data-ramal="3"
          pathLength="1"
          x="720"
          y="306"
          width="100"
          height="56"
          rx="3"
          style="--dl:1.3s;--d:600ms"></rect>
        <path class="u-line" data-ramal="3" pathLength="1" d="M750 392H790" style="--dl:1.35s;--d:300ms"></path>
        <rect
          class="u-fill"
          data-ramal="4"
          pathLength="1"
          x="974"
          y="300"
          width="132"
          height="46"
          rx="3"
          style="--dl:1.3s;--d:600ms"></rect>
        <rect
          class="u-fill"
          data-ramal="4"
          pathLength="1"
          x="990"
          y="314"
          width="18"
          height="18"
          rx="3"
          style="--dl:1.4s;--d:600ms"></rect>
        <rect
          class="u-fill"
          data-ramal="4"
          pathLength="1"
          x="1018"
          y="314"
          width="18"
          height="18"
          rx="3"
          style="--dl:1.4s;--d:600ms"></rect>
        <rect
          class="u-fill"
          data-ramal="4"
          pathLength="1"
          x="1046"
          y="314"
          width="18"
          height="18"
          rx="3"
          style="--dl:1.4s;--d:600ms"></rect>
        <rect
          class="u-fill"
          data-ramal="4"
          pathLength="1"
          x="1074"
          y="314"
          width="18"
          height="18"
          rx="3"
          style="--dl:1.4s;--d:600ms"></rect>
        <path
          class="u-line"
          data-ramal="4"
          pathLength="1"
          d="M1000 346V440M1040 346V460M1080 346V440"
          style="--dl:1.4s;--d:400ms"></path>
        <text class="u-text" data-ramal="1" x="230" y="530" text-anchor="middle" style="--dl:1.5s">01 FUERZA</text>
        <text class="u-text" data-ramal="2" x="500" y="530" text-anchor="middle" style="--dl:1.55s">02 CONTROL</text>
        <text class="u-text" data-ramal="3" x="770" y="530" text-anchor="middle" style="--dl:1.6s">03 SUPERVISIÓN</text>
        <text class="u-text" data-ramal="4" x="1040" y="530" text-anchor="middle" style="--dl:1.65s"
          >04 COMUNICACIONES</text
        >
      </svg>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="sol-hero-grid hub-hero-grid">
        <div class="sol-hero-copy">
          <nav class="sol-crumb" aria-label="Miga de pan">
            <a href="/">Inicio</a>
            <span aria-hidden="true" class="sol-crumb-sep">/</span>
            <span aria-current="page">Soluciones</span>
          </nav>
          <h1 class="sol-h1" id="hero-h1">
            Soluciones en tableros eléctricos industriales: fuerza, control y <mark class="acento">supervisión</mark>
          </h1>
          <p class="sol-lead">
            Cuatro frentes de ingeniería para tu planta: tableros de fuerza, control con PLC, interfaces HMI y redes de
            comunicación. Diseño alineado con RIC N°2 e IEC 61439, con pruebas FAT antes del despacho.
          </p>
          <div class="sol-cta-row">
            <a href="/contacto/" class="sol-btn-primary">Definir mi proyecto</a>
            <a
              href="https://wa.me/56935935595?text=Hola%2C%20los%20contacto%20desde%20telectrich.cl"
              class="sol-btn-outline"
              data-wa="hero"
            >
              <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                ></path>
              </svg>
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--blanco" aria-labelledby="qr">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="sol-sec-head">
        <h2 class="sol-h2" id="qr">Qué resolvemos</h2>
      </div>
      <div class="hub-sol-rows">
        {
          SOLUCIONES.map((sol) => {
            const fotoKey = fotoPorSolucion[sol.ruta] ?? sol.foto;
            const imgSrc = fotos[fotoKey] ?? distSchneider;
            const alt = altPorFoto[fotoKey] ?? sol.alt;
            const posicion = posicionPorFoto[fotoKey] ?? '50% 50%';
            const dim = dimPorFoto[fotoKey] ?? { w: 1000, h: 750 };
            const ticks = vinyetasPorSolucion[sol.ruta] ?? [];
            return (
              <article class="hub-sol-row" data-reveal>
                <figure class="hub-sol-photo">
                  <Image
                    src={imgSrc}
                    alt={alt}
                    width={dim.w}
                    height={dim.h}
                    class="hub-sol-img"
                    style={`object-position: ${posicion};`}
                    loading="lazy"
                  />
                </figure>
                <div class="hub-sol-txt">
                  <span class="hub-sol-num">{sol.numero}</span>
                  <h3 class="hub-sol-titulo">
                    <a href={sol.ruta}>{sol.nombre}</a>
                  </h3>
                  <p class="hub-sol-resumen">{sol.resumen}</p>
                  {ticks.length > 0 && (
                    <ul class="hub-sol-ticks">
                      {ticks.map((t) => (
                        <li>
                          <span class="vineta-amarilla" aria-hidden="true" />
                          <span>{t}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  <a class="hub-sol-link" href={sol.ruta}>
                    Ver solución
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="band band--fondo" aria-labelledby="ct">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="sol-split">
        <div class="sol-prose">
          <h2 class="sol-h2" id="ct">Cómo trabajamos</h2>
          <p class="sol-prose-p">
            Cada proyecto sigue la misma secuencia: diseño, fabricación en nuestro taller de Buin, pruebas de fábrica
            antes del despacho, comisionamiento en terreno y puesta en marcha con arranque coordinado.
          </p>
          <p class="sol-link-row">
            <a class="sol-link-arrow" href="/pruebas-fat-sat-y-comisionamiento/">
              Conoce cómo desarrollamos las pruebas en nuestra fábrica
              <svg
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 8h10M9 4l4 4-4 4"></path>
              </svg>
            </a>
            <a class="sol-link-arrow" href="/empresa/">
              Conoce la empresa
              <svg
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 8h10M9 4l4 4-4 4"></path>
              </svg>
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--blanco" aria-labelledby="pq">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="sol-sec-head">
        <h2 class="sol-h2" id="pq">Por qué Telectrich</h2>
      </div>
      <div class="sol-panels sol-panels--3">
        <div class="sol-panel">
          <h3 class="sol-h3">Rigor normativo</h3>
          <p>Diseños alineados con el Pliego Técnico RIC N°2 (SEC Chile) y la serie IEC 61439.</p>
        </div>
        <div class="sol-panel">
          <h3 class="sol-h3">Componentes de marcas premium</h3>
          <p>
            Integramos Siemens, ABB, Schneider Electric, Rockwell Automation y otras marcas premium según
            especificación.
          </p>
        </div>
        <div class="sol-panel">
          <h3 class="sol-h3">Diseño para la mantenibilidad</h3>
          <p>
            Ordenamiento interno y etiquetado profesional que reduce tiempos de diagnóstico y reparación en terreno.
          </p>
        </div>
      </div>
    </div>
  </section>

  <BandaFinal
    titulo="¿Necesitas definir la solución eléctrica de tu proyecto?"
    palabraAcento="solución"
    botonTexto="Definir la solución de mi proyecto"
  />
</TelectrichLayout>

<style is:global>
  .hub-hero-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .hub-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  /* --- Static unifilar (replicado del PaginaSolucion para que aplique aquí) --- */
  .sol-hero {
    overflow: hidden;
  }

  .sol-hero-bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .sol-unifilar {
    width: 100%;
    height: auto;
    overflow: visible;
    opacity: 0.16;
  }

  .sol-unifilar .u-fill,
  .sol-unifilar .u-line,
  .sol-unifilar .u-text {
    stroke: #ffcb08;
    fill: #ffcb08;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .sol-unifilar .u-bus {
    stroke-width: 2;
  }

  .sol-unifilar .u-text {
    stroke: none;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
  }

  /* --- Layout del hero --- */
  .sol-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .sol-hero-grid {
      grid-template-columns: 7fr 5fr;
      gap: 4rem;
    }
  }

  .sol-hero-copy {
    display: grid;
    gap: 1.5rem;
  }

  .sol-crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
    font-family: var(--font-mono);
  }

  .sol-crumb a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }

  .sol-crumb a:hover {
    color: #ffcb08;
  }

  .sol-crumb-sep {
    color: rgba(255, 255, 255, 0.35);
  }

  .sol-crumb [aria-current='page'] {
    color: #ffcb08;
  }

  .sol-h1 {
    color: #ffffff;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.028em;
    font-size: clamp(2rem, 1.1rem + 3.6vw, 4rem);
    margin: 0;
  }

  .sol-lead {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.3125rem);
    line-height: 1.55;
    max-width: 56ch;
    margin: 0;
  }

  .sol-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .sol-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    padding: 0 1.5rem;
    background-color: #ffcb08;
    color: #101f2c;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .sol-btn-primary:hover {
    background-color: rgba(255, 203, 8, 0.9);
  }

  .sol-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    padding: 0 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background-color: transparent;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 6px;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .sol-btn-outline:hover {
    background-color: rgba(255, 255, 255, 0.14);
  }

  /* --- Secciones de página --- */
  .sol-h2 {
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.022em;
    color: #101f2c;
    margin: 0;
  }

  .band--noche .sol-h2,
  .band--noche .sol-h3 {
    color: #ffffff;
  }

  .sol-h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #101f2c;
    margin: 0 0 0.5rem;
  }

  .sol-prose {
    max-width: 62ch;
  }

  .sol-prose-p {
    color: #586a78;
    font-size: 1rem;
    line-height: 1.65;
    margin: 1.5rem 0 0;
  }

  .band--noche .sol-prose-p {
    color: rgba(255, 255, 255, 0.72);
  }

  .sol-sec-head {
    margin-bottom: 2.5rem;
  }

  .sol-split {
    display: grid;
    gap: 2rem;
  }

  .sol-panels {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .sol-panels--3 {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .sol-panels--3 {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .sol-panels--3 {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .sol-panel {
    padding: 1.5rem;
    background-color: #ffffff;
    border: 1px solid #e3e8ec;

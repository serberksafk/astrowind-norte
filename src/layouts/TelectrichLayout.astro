---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { headerData, footerData } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  bar?: boolean;
}

const { metadata, bar = true } = Astro.props;
const isNoBarPage = Astro.url.pathname === '/contacto/' || Astro.url.pathname === '/privacidad/';
const showBar = bar && !isNoBarPage;
---

<Layout metadata={metadata}>
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-acento focus:text-noche focus:font-semibold focus:rounded"
  >
    Saltar al contenido
  </a>

  <div style="view-transition-name: header-transition;">
    <Header
      {...headerData}
      isSticky={true}
      isDark={true}
      position="center"
      showToggleTheme={false}
      showRssFeed={false}
    />
  </div>

  <main id="main-content" class="flex-1">
    <slot />
  </main>

  <Footer
    {...footerData}
    theme="light"
  />

  {showBar && (
    <div
      id="barra-fija"
      class="fixed bottom-0 left-0 right-0 z-50 lg:hidden bg-noche text-white h-14 px-4 flex items-center justify-around gap-4"
      style="padding-bottom: env(safe-area-inset-bottom, 0); view-transition-name: barra-transition;"
    >
      <a
        href="/contacto/"
        class="flex-1 h-11 flex items-center justify-center bg-acento text-noche font-semibold rounded-md text-sm"
      >
        Cotizar
      </a>
      <a
        href="https://wa.me/56935935595?text=Hola%2C%20los%20contacto%20desde%20telectrich.cl"
        class="flex items-center justify-center h-11 px-4 border border-white rounded-md text-sm"
        aria-label="Contactar por WhatsApp"
      >
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      </a>
    </div>
  )}

  <div
    id="whatsapp-flotante"
    class="hidden lg:block fixed bottom-6 right-6 z-50"
    style="view-transition-name: whatsapp-transition;"
  >
    <a
      href="https://wa.me/56935935595?text=Hola%2C%20los%20contacto%20desde%20telectrich.cl"
      class="flex items-center justify-center w-14 h-14 bg-acento text-noche rounded-full shadow-lg hover:scale-110 transition-transform"
      aria-label="Contactar por WhatsApp"
      data-wa-ubicacion="flotante"
      data-wa-pagina="global"
    >
      <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </div>

  <div
    id="cookie-banner"
    class="fixed bottom-0 left-0 right-0 z-50 bg-fondo border-t border-borde p-4 shadow-lg hidden"
    role="dialog"
    aria-label="Configuración de cookies"
  >
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-cuerpo text-center sm:text-left">
        Usamos cookies para mejorar tu experiencia. Al continuar navegando, aceptas nuestra{' '}
        <a href="/privacidad/#cookies" class="text-noche underline">política de privacidad</a>.
      </p>
      <div class="flex gap-3 shrink-0">
        <button
          id="cookie-aceptar"
          class="px-4 py-2 text-sm font-semibold border border-noche-2 text-noche-2 rounded-md hover:bg-noche-2 hover:text-white transition-colors"
        >
          Aceptar
        </button>
        <button
          id="cookie-rechazar"
          class="px-4 py-2 text-sm font-semibold border border-noche-2 text-noche-2 rounded-md hover:bg-noche-2 hover:text-white transition-colors"
        >
          Rechazar
        </button>
      </div>
    </div>
  </div>

  <script>
    declare global {
      interface Window {
        dataLayer?: unknown[];
      }
    }

    const barra = document.getElementById('barra-fija');
    const flotante = document.getElementById('whatsapp-flotante');
    const banner = document.getElementById('cookie-banner');

    function initCookies() {
      try {
        const consent = localStorage.getItem('cookie-consent');
        if (consent === null && banner) {
          banner.classList.remove('hidden');
        }
      } catch (e) {}
    }

    function hideBar() {
      if (barra) barra.classList.add('translate-y-full');
    }

    function showBar() {
      if (barra) barra.classList.remove('translate-y-full');
    }

    function hideFlotante() {
      if (flotante) flotante.classList.add('hidden');
    }

    function showFlotante() {
      if (flotante) flotante.classList.remove('hidden');
    }

    function hideBanner() {
      if (banner) banner.classList.add('hidden');
    }

    document.getElementById('cookie-aceptar')?.addEventListener('click', () => {
      try {
        localStorage.setItem('cookie-consent', 'accepted');
        if (!window.dataLayer) window.dataLayer = [];
        window.dataLayer.push({ event: 'cookie_consent', consent: 'accepted' });
      } catch (e) {}
      hideBanner();
    });

    document.getElementById('cookie-rechazar')?.addEventListener('click', () => {
      try {
        localStorage.setItem('cookie-consent', 'rejected');
        if (!window.dataLayer) window.dataLayer = [];
        window.dataLayer.push({ event: 'cookie_consent', consent: 'rejected' });
      } catch (e) {}
      hideBanner();
    });

    if (barra || flotante) {
      const heroObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              hideBar();
              hideFlotante();
            } else {
              showBar();
              showFlotante();
            }
          });
        },
        { threshold: 0 }
      );

      document.querySelectorAll('section:first-of-type, footer').forEach((el) => {
        heroObserver.observe(el);
      });
    }

    initCookies();

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (barra) {
        barra.classList.remove('translate-y-full');
        barra.style.transition = 'none';
      }
      if (flotante) {
        flotante.style.transition = 'none';
      }
    }
  </script>
</Layout>

<style>
  @media (prefers-reduced-motion: reduce) {
    #barra-fija,
    #whatsapp-flotante {
      transition: none !important;
      transform: none !important;
    }
  }

  #barra-fija {
    transition: transform 0.2s ease-out;
  }

  #barra-fija.translate-y-full {
    transform: translateY(100%);
  }
</style>

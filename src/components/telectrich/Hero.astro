---
import { CONTACTO } from '~/data/sitio';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import hero1 from '~/assets/hero/hero-1.jpg';
import hero2 from '~/assets/hero/hero-2.jpg';
import plcS71200 from '~/assets/img/plc-s7-1200.jpg';
import controlS7300 from '~/assets/img/control-s7-300.jpg';
import plcAbbPm564 from '~/assets/img/plc-abb-pm564.jpg';

export interface Props {
  variante?: 'home' | 'corto' | 'solucion';
  titulo: string;
  bajada?: string;
  palabraAcento?: string;
  foto?: string;
  alt?: string;
  ramalIluminado?: number;
}

const {
  variante = 'home',
  titulo,
  bajada,
  palabraAcento,
  foto,
  alt = '',
  ramalIluminado,
} = Astro.props;

const whatsappUrl = CONTACTO.whatsapp;

const fotosHero: Record<string, ImageMetadata> = {
  'plc-s7-1200': plcS71200,
  'control-s7-300': controlS7300,
  'plc-abb-pm564': plcAbbPm564,
  'hero-1': hero1,
  'hero-2': hero2,
};

function procesarTexto(texto: string, palabra?: string): string {
  if (!palabra) return texto;
  return texto.replace(palabra, `<mark class="acento">${palabra}</mark>`);
}

const fotoSrc = foto ? fotosHero[foto] ?? hero1 : null;
const fotoAlt = alt || (foto === 'plc-s7-1200' ? 'PLC Siemens S7-1200 con cableado identificado en un tablero de control' : 'Tablero eléctrico industrial con cableado e instrumentación');
---

{variante === 'home' && (
  <section class="band band--canaleta hero-home" aria-labelledby="hero-h1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 class="text-white font-semibold leading-tight" id="hero-h1" set:html={procesarTexto(titulo, palabraAcento)} />
          {bajada && <p class="hero-bajada" set:html={procesarTexto(bajada, palabraAcento)} />}
          <div class="hero-actions">
            <a href="/contacto/" class="hero-btn-primary">Conversemos</a>
            <a href={whatsappUrl} class="hero-btn-outline">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              WhatsApp
            </a>
          </div>
        </div>
        {fotoSrc && (
          <div class="hero-photo">
            <Image
              src={fotoSrc}
              alt={fotoAlt}
              width={960}
              height={1200}
              class="w-full h-auto rounded-md object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}
      </div>
    </div>
  </section>
)}

{variante === 'corto' && (
  <section class="band band--canaleta" aria-labelledby="hero-h1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h1 class="text-white font-semibold leading-tight" id="hero-h1" set:html={procesarTexto(titulo, palabraAcento)} />
      {bajada && <p class="hero-bajada max-w-3xl" set:html={procesarTexto(bajada, palabraAcento)} />}
    </div>
  </section>
)}

{variante === 'solucion' && (
  <section class="band band--canaleta" aria-labelledby="hero-h1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="hero-grid">
        <div>
          <h1 class="text-white font-semibold leading-tight" id="hero-h1" set:html={procesarTexto(titulo, palabraAcento)} />
          {bajada && <p class="hero-bajada" set:html={procesarTexto(bajada, palabraAcento)} />}
        </div>
        {fotoSrc && (
          <div class="hero-photo">
            <Image
              src={fotoSrc}
              alt={alt || fotoAlt}
              width={960}
              height={1200}
              class="w-full h-auto rounded-md object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .hero-home h1 {
    font-size: clamp(2rem, 1.1rem + 3.6vw, 4.25rem);
    letter-spacing: -0.028em;
    line-height: 1.03;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 7fr 5fr;
      gap: 4rem;
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.75rem;
    position: relative;
    z-index: 2;
  }

  .hero-bajada {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.3125rem);
    line-height: 1.55;
    max-width: 56ch;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    padding: 0 1.5rem;
    background-color: var(--color-acento);
    color: var(--color-noche);
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .hero-btn-primary:hover {
    background-color: rgba(255, 203, 8, 0.9);
  }

  .hero-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    padding: 0 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background-color: transparent;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .hero-btn-outline:hover {
    background-color: rgba(255, 255, 255, 0.14);
  }

  .hero-photo {
    position: relative;
  }
</style>
---
import type { Solucion } from '~/data/sitio';
import { Image } from 'astro:assets';
import distSchneider from '~/assets/img/distribucion-schneider.jpg';
import controlAbb from '~/assets/img/control-abb-interior.jpg';
import hmiNema from '~/assets/img/hmi-nema4x.jpg';
import switchEmerson from '~/assets/img/switch-emerson.jpg';

export interface Props {
  solucion: Solucion;
}

const { solucion } = Astro.props;

const fotos: Record<string, ImageMetadata> = {
  'distribucion-schneider': distSchneider,
  'control-abb-interior': controlAbb,
  'hmi-nema4x': hmiNema,
  'switch-emerson': switchEmerson,
};

const imgSrc = fotos[solucion.foto] || distSchneider;
---

<article class="tarjeta-solucion">
  <figure class="tarjeta-foto">
    <Image
      src={imgSrc}
      alt={solucion.alt}
      width={800}
      height={600}
      class="w-full h-auto object-cover rounded-md aspect-[4/3]"
      loading="lazy"
    />
  </figure>
  <div class="tarjeta-body">
    <span class="numero-grande" aria-hidden="true">{solucion.numero}</span>
    <h3 class="tarjeta-titulo">
      <a href={solucion.ruta}>{solucion.nombre}</a>
      <span class="ul"></span>
    </h3>
    <p class="tarjeta-resumen">{solucion.resumen}</p>
    <span class="tarjeta-link">
      Ver solución
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </span>
  </div>
</article>

<style>
  .tarjeta-solucion {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .tarjeta-foto {
    margin: 0;
    overflow: hidden;
    border-radius: 6px;
  }

  .tarjeta-body {
    padding: 1.25rem 0 0;
  }

  .numero-grande {
    font-family: var(--font-mono);
    font-size: 3rem;
    line-height: 1;
    font-weight: 500;
    color: #FFCB08;
    display: block;
    margin-bottom: 0.5rem;
  }

  .tarjeta-titulo {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    position: relative;
    display: inline-block;
  }

  .tarjeta-titulo a {
    color: #101F2C;
    text-decoration: none;
  }

  .tarjeta-titulo .ul {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: #FFCB08;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.24s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .tarjeta-titulo a:hover + .ul,
    .tarjeta-titulo a:focus + .ul {
      transform: scaleX(1);
    }
  }

  .tarjeta-resumen {
    font-size: 0.9375rem;
    color: #586A78;
    line-height: 1.5;
    margin: 0.75rem 0;
  }

  .tarjeta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #101F2C;
  }

  .tarjeta-link svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.15s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .tarjeta-link:hover svg {
      transform: translateX(4px);
    }
  }
</style>

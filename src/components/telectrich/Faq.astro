---
export interface Props {
  items: { pregunta: string; respuesta: string }[];
}

const { items } = Astro.props;
---

<div class="faq">
  {items.map((item) => (
    <details class="faq-item">
      <summary class="faq-pregunta">
        {item.pregunta}
        <svg class="faq-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m5 8 5 5 5-5"/>
        </svg>
      </summary>
      <div class="faq-respuesta">
        <p>{item.respuesta}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-item {
    border-bottom: 1px solid #E3E8EC;
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-pregunta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1.25rem 0;
    font-size: 1rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    list-style: none;
    color: #101F2C;
  }

  .faq-pregunta::-webkit-details-marker {
    display: none;
  }

  .faq-pregunta:hover {
    color: #152C3D;
  }

  .faq-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    transition: transform 0.18s ease-out;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-respuesta {
    padding-bottom: 1.25rem;
    color: #586A78;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .faq-respuesta p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon {
      transition: none;
    }
  }
</style>

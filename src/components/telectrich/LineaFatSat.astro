---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface FotoLinea {
  src: ImageMetadata;
  alt: string;
  posicion?: string;
  ancho?: number;
  alto?: number;
}

export interface PasoFatSat {
  numero: string;
  tag: string;
  titulo: string;
  descripcion: string;
  fotos?: FotoLinea[];
  sticky?: boolean;
  kIndex?: number;
}

export interface Props {
  pasos: PasoFatSat[];
}

const { pasos } = Astro.props;
---

<div class="linea-fat-sat" data-linea>
  <div class="linea-rail" aria-hidden="true"></div>
  <div class="linea-fill" aria-hidden="true"></div>
  <ol class="linea-steps">
    {
      pasos.map((paso) => (
        <li
          class:list={['linea-step', paso.sticky && 'linea-step--stick']}
          style={paso.sticky ? `--k: ${paso.kIndex ?? 0};` : '--k: -1;'}
        >
          <span class="linea-node" aria-hidden="true">
            {paso.numero}
          </span>
          <span class="etiqueta linea-tag">{paso.tag}</span>
          <div class="linea-step-grid">
            <div class="linea-step-text">
              <h3 class="linea-step-titulo">{paso.titulo}</h3>
              <p class="linea-step-desc">{paso.descripcion}</p>
            </div>
            {paso.fotos && paso.fotos.length > 0 && (
              <div class:list={['linea-ph', paso.fotos.length === 1 && 'linea-ph--one']}>
                {paso.fotos.map((foto) => (
                  <figure class="linea-ph-fig">
                    <Image
                      src={foto.src}
                      alt={foto.alt}
                      width={foto.ancho ?? 720}
                      height={foto.alto ?? 1280}
                      loading="lazy"
                      class="linea-ph-img"
                      style={`object-position: ${foto.posicion ?? '50% 50%'};`}
                    />
                  </figure>
                ))}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
  <div class="linea-end">
    <slot name="fin" />
  </div>
</div>

<script>
  type LineaEl = HTMLElement & { __lineaInited?: boolean };

  function initLinea(root: LineaEl): void {
    if (root.__lineaInited) return;
    root.__lineaInited = true;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const supportsTimeline = CSS.supports?.('animation-timeline', 'view()');

    const steps = Array.from(root.querySelectorAll<HTMLElement>('.linea-step'));

    if (reducedMotion) {
      root.style.setProperty('--p', '1');
      steps.forEach((s) => s.classList.add('on'));
      return;
    }

    if (supportsTimeline) {
      // CSS animation-timeline ya hace el trabajo; nada que hacer.
      return;
    }

    // Fallback: scroll listener + IntersectionObserver (sin rAF en cada evento).
    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = root.getBoundingClientRect();
      const vh = window.innerHeight;
      const y = vh * 0.6;
      const p = Math.min(1, Math.max(0, (y - rect.top - 20) / Math.max(1, rect.height - 140)));
      root.style.setProperty('--p', p.toFixed(4));
      steps.forEach((s) => {
        s.classList.toggle('on', s.getBoundingClientRect().top < y);
      });
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  function bootstrap() {
    document.querySelectorAll<LineaEl>('[data-linea]').forEach(initLinea);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
  } else {
    bootstrap();
  }
  document.addEventListener('astro:page-load', bootstrap);
</script>

<style>
  .linea-fat-sat {
    position: relative;
    padding-left: 76px;
  }

  .linea-rail {
    position: absolute;
    left: 19px;
    top: 20px;
    bottom: 120px;
    width: 2px;
    background: #2a4a61;
    z-index: 0;
  }

  .linea-fill {
    position: absolute;
    left: 19px;
    top: 20px;
    bottom: 120px;
    width: 2px;
    background: #ffcb08;
    z-index: 1;
    transform-origin: top;
    transform: scaleY(var(--p, 1));
  }

  .linea-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .linea-step {
    position: relative;
    display: grid;
    gap: 20px;
    background: #152c3d;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    padding: clamp(22px, 3vw, 40px);
    z-index: 1;
  }

  @media (min-width: 768px) {
    .linea-step--stick {
      position: sticky;
      top: calc(64px + 16px + var(--k, 0) * 20px);
    }
  }

  .linea-node {
    position: absolute;
    left: -76px;
    top: 22px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffcb08;
    color: #101f2c;
    border: 2px solid #ffcb08;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
    z-index: 2;
  }

  .linea-tag {
    justify-self: start;
  }

  .linea-step-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: start;
  }

  .linea-step-titulo {
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.18;
    color: #ffffff;
    margin: 0;
  }

  .linea-step-desc {
    margin-top: 10px;
    color: rgba(255, 255, 255, 0.72);
    max-width: 56ch;
    font-size: 1rem;
    line-height: 1.6;
  }

  .linea-ph {
    display: flex;
    gap: 12px;
  }

  .linea-ph-fig {
    margin: 0;
    border-radius: 6px;
    overflow: hidden;
    width: 150px;
    aspect-ratio: 9 / 16;
    background: #101f2c;
  }

  .linea-ph--one .linea-ph-fig {
    width: 320px;
    max-width: 100%;
    aspect-ratio: 4 / 3;
  }

  .linea-ph-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .linea-end {
    display: grid;
    gap: 22px;
    padding-top: 12px;
    max-width: 62ch;
    position: relative;
    z-index: 1;
  }

  /* Estados con JS: tarjeta dim por defecto, se enciende al cruzarse con el riel. */
  :global(html.js) .linea-step {
    opacity: 0.55;
    transition: opacity 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global(html.js) .linea-step.on {
    opacity: 1;
  }

  :global(html.js) .linea-node {
    background: #101f2c;
    color: #fff;
    border-color: #2a4a61;
  }

  :global(html.js) .linea-step.on .linea-node {
    background: #ffcb08;
    color: #101f2c;
    border-color: #ffcb08;
  }

  :global(html.js) .linea-tag {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global(html.js) .linea-step.on .linea-tag {
    clip-path: inset(0);
  }

  /* animation-timeline (moderno): el riel se llena solo. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* La timeline va en selectores separados: lightningcss fusiona
         `animation-timeline` dentro del shorthand `animation` (que no lo admite)
         y el navegador descarta la regla completa. */
      [data-linea] .linea-fill {
        animation: linea-fill-anim linear both;
      }
      [data-linea] > .linea-fill {
        animation-timeline: view();
        animation-range: contain;
      }

      [data-linea] .linea-step {
        animation: linea-step-anim linear both;
      }
      [data-linea] .linea-steps > .linea-step {
        animation-timeline: view();
        animation-range: contain 0% contain 30%;
      }

      [data-linea] .linea-step .linea-tag {
        animation: linea-tag-anim linear both;
      }
      [data-linea] .linea-steps > .linea-step .linea-tag {
        animation-timeline: view();
        animation-range: contain 0% contain 20%;
      }

      [data-linea] .linea-step .linea-node {
        animation: linea-node-anim linear both;
      }
      [data-linea] .linea-steps > .linea-step .linea-node {
        animation-timeline: view();
        animation-range: contain 0% contain 20%;
      }

      @keyframes linea-fill-anim {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }

      @keyframes linea-step-anim {
        from {
          opacity: 0.55;
        }
        to {
          opacity: 1;
        }
      }

      @keyframes linea-tag-anim {
        from {
          clip-path: inset(0 100% 0 0);
        }
        to {
          clip-path: inset(0);
        }
      }

      @keyframes linea-node-anim {
        from {
          background: #101f2c;
          color: #fff;
          border-color: #2a4a61;
        }
        to {
          background: #ffcb08;
          color: #101f2c;
          border-color: #ffcb08;
        }
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .linea-fill {
      transform: scaleY(1);
    }
    .linea-step,
    .linea-step .linea-tag,
    .linea-step .linea-node {
      animation: none !important;
      transition: none !important;
      opacity: 1 !important;
      clip-path: none !important;
    }
    .linea-node {
      background: #ffcb08 !important;
      color: #101f2c !important;
      border-color: #ffcb08 !important;
    }
  }

  @media (max-width: 767px) {
    .linea-fat-sat {
      padding-left: 56px;
    }
    .linea-node {
      left: -56px;
    }
    .linea-rail,
    .linea-fill {
      left: 19px;
    }
    .linea-step-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .linea-ph {
      flex-wrap: wrap;
    }
    .linea-ph-fig {
      width: 110px;
    }
    .linea-ph--one .linea-ph-fig {
      width: 100%;
      max-width: 360px;
    }
  }
</style>
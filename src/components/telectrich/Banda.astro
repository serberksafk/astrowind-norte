---
export interface Props {
  variante?: 'noche' | 'blanco' | 'fondo' | 'canaleta';
  clase?: string;
  pequena?: boolean;
}

const { variante = 'blanco', clase = '', pequena = false } = Astro.props;

const clases = {
  noche: 'band--noche',
  blanco: 'band--blanco',
  fondo: 'band--fondo',
  canaleta: 'band--canaleta',
};
---

<section class:list={['band', clases[variante], pequena && 'band--sm', clase]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <slot />
  </div>
</section>
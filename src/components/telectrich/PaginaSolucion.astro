                      class="sol-fig-img"
                    />
                  </figure>
                </div>
              </div>
            </div>
          </section>
        );
      }

      if (sec.tipo === 'faq') {
        const variante = sec.variante ?? 'blanco';
        const tieneHtml = sec.items.some((it) => it.respuestaHtml);
        if (tieneHtml) {
          return (
            <section
              class:list={['band', variante === 'fondo' ? 'band--fondo' : 'band--blanco']}
              aria-labelledby={`faq-${sec.titulo}`}
            >
              <div class="max-w-7xl mx-auto px-4 sm:px-6">
                <div class="sol-sec-head">
                  <h2 class="sol-h2" id={`faq-${sec.titulo}`}>
                    {sec.titulo}
                  </h2>
                </div>
                <div class="faq">
                  {sec.items.map((it) => (
                    <details class="faq-item">
                      <summary class="faq-pregunta">
                        {it.pregunta}
                        <svg
                          class="faq-icon"
                          viewBox="0 0 20 20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m5 8 5 5 5-5" />
                        </svg>
                      </summary>
                      <div class="faq-respuesta">
                        <p set:html={it.respuestaHtml} />
                      </div>
                    </details>
                  ))}
                </div>
              </div>
            </section>
          );
        }
        const faqNormalizado = sec.items.map((it) => ({
          pregunta: it.pregunta,
          respuesta: it.respuestaHtml ?? it.respuesta,
        }));
        return (
          <section
            class:list={['band', variante === 'fondo' ? 'band--fondo' : 'band--blanco']}
            aria-labelledby={`faq-${sec.titulo}`}
          >
            <div class="max-w-7xl mx-auto px-4 sm:px-6">
              <div class="sol-sec-head">
                <h2 class="sol-h2" id={`faq-${sec.titulo}`}>
                  {sec.titulo}
                </h2>
              </div>
              <Faq items={faqNormalizado} />
            </div>
          </section>
        );
      }

      return null;
    })
  }

  <BandaFinal titulo={bandaFinal.titulo} palabraAcento={bandaFinal.palabraAcento} botonTexto={bandaFinal.botonTexto} />

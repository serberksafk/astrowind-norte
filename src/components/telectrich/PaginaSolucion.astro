                  </h2>
                  <p class="sol-prose-p">{sec.contenido}</p>
                  <p class="sol-prose-p">
                    {sec.parrafoExtra}
                    {sec.enlace && (
                      <>
                        {' '}
                        <a class="sol-link-arrow" href={sec.enlace.href}>
                          {sec.enlace.texto}
                          <svg
                            viewBox="0 0 16 16"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M3 8h10M9 4l4 4-4 4" />

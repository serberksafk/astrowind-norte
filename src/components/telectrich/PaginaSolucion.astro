<style is:global>
  /* --- Static unifilar (hero de las páginas de solución) ---
     El F0 Unifilar.astro usa opacity inline, lo que impide iluminar un ramal
     con .u-lit sin tocar F0. Aquí re-renderizamos el SVG con la clase
     [data-ramal-lit] y la opacidad se maneja por CSS (unlit a 0.16, lit a 1). */
  .sol-hero {
    overflow: hidden;
  }

  .sol-hero-bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .sol-unifilar {
    width: 100%;
    height: auto;
    overflow: visible;
    opacity: 0.16;
  }

  .sol-unifilar .u-fill,
  .sol-unifilar .u-line,
  .sol-unifilar .u-text {
    stroke: #ffcb08;
    fill: #ffcb08;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .sol-unifilar .u-bus {
    stroke-width: 2;
  }

  .sol-unifilar .u-text {
    stroke: none;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
  }

  /* Ramal iluminado: opacidad 1, color lleno. */
  .sol-unifilar[data-ramal-lit='1'] [data-ramal='1'],
  .sol-unifilar[data-ramal-lit='2'] [data-ramal='2'],
  .sol-unifilar[data-ramal-lit='3'] [data-ramal='3'],
  .sol-unifilar[data-ramal-lit='4'] [data-ramal='4'] {
    opacity: 1;
  }

  /* Dibujo con stroke-dashoffset (CSS, una vez). */
  @media (prefers-reduced-motion: no-preference) {
    .sol-unifilar .u-line,
    .sol-unifilar .u-fill,
    .sol-unifilar .u-text {
      animation-duration: var(--d, 600ms);
      animation-delay: var(--dl, 0s);
      animation-fill-mode: both;
      animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
    }

    .sol-unifilar .u-line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation-name: sol-unifilar-draw;
    }

    .sol-unifilar .u-fill {
      transform-origin: center;
      transform-box: fill-box;
      animation-name: sol-unifilar-pop;
    }

    .sol-unifilar .u-text {
      animation-name: sol-unifilar-fade;
    }

    @keyframes sol-unifilar-draw {
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes sol-unifilar-pop {
      from {
        opacity: 0;
        transform: scale(0.6);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes sol-unifilar-fade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }


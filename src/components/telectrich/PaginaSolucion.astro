                role="img"
                aria-label="Tres niveles de una red industrial: campo, control y supervisión"
                fill="none"
                stroke="#FFCB08"
                stroke-width="2"
                stroke-linecap="round"
              >
                <path class="sol-arch-line" d="M110 60H340" pathLength="1" />
                <path class="sol-arch-line" d="M560 60H790" pathLength="1" />
                <circle class="sol-arch-node" cx="90" cy="60" r="20" fill="#152C3D" />
                <rect class="sol-arch-node" x="340" y="38" width="220" height="44" rx="4" fill="#152C3D" />
                <rect class="sol-arch-node" x="790" y="34" width="70" height="52" rx="4" fill="#152C3D" />
                <path d="M335 60l-8-5v10zM795 60l-8-5v10z" fill="#FFCB08" stroke="none" />
              </svg>
              <div class="sol-arch">
                <div class="sol-arch-lv">
                  <span class="etiqueta">N1</span>
                  <h3 class="sol-h3">Campo</h3>
                  <p>Sensores, actuadores y equipos de planta.</p>
                </div>
                <div class="sol-arch-lv">
                  <span class="etiqueta">N2</span>
                  <h3 class="sol-h3">Control</h3>
                  <p>PLC y tableros de control.</p>
                  <a class="sol-link-arrow" href="/soluciones/tableros-de-control/">
                    Ver tableros de control
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </a>
                </div>
                <div class="sol-arch-lv">

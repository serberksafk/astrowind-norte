                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </section>
        );
      }

      if (sec.tipo === 'valor') {
        return (
          <section class="band band--blanco" aria-labelledby={`val-${sec.titulo}`}>
            <div class="max-w-7xl mx-auto px-4 sm:px-6">
              <div class="sol-feat sol-feat--con-foto">
                <div class="sol-feat-a sol-prose">
                  <h2 class="sol-h2" id={`val-${sec.titulo}`}>

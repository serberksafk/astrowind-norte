---
export interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="lista-alcance">
  {items.map((item) => (
    <li class="lista-item">
      <span class="vineta-amarilla"></span>
      {item}
    </li>
  ))}
</ul>

<style>
  .lista-alcance {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lista-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: #101F2C;
    line-height: 1.5;
  }
</style>

---
import { MARCAS } from '~/data/sitio';
import MarcaSiemens from '~/assets/marcas/marca-siemens.svg?url';
import MarcaAbb from '~/assets/marcas/marca-abb.svg?url';
import MarcaSchneider from '~/assets/marcas/marca-schneider-electric.svg?url';
import MarcaRockwell from '~/assets/marcas/marca-rockwell-automation.svg?url';
import MarcaRittal from '~/assets/marcas/marca-rittal.svg?url';
import MarcaEaton from '~/assets/marcas/marca-eaton.svg?url';
import MarcaLegrand from '~/assets/marcas/marca-legrand.svg?url';
import MarcaPhoenix from '~/assets/marcas/marca-phoenix-contact.svg?url';

function getLogoSrc(nombre: string): string | undefined {
  if (nombre === 'SIEMENS') return MarcaSiemens as unknown as string;
  if (nombre === 'ABB') return MarcaAbb as unknown as string;
  if (nombre === 'Schneider Electric') return MarcaSchneider as unknown as string;
  if (nombre === 'Rockwell Automation') return MarcaRockwell as unknown as string;
  if (nombre === 'Rittal') return MarcaRittal as unknown as string;
  if (nombre === 'Eaton') return MarcaEaton as unknown as string;
  if (nombre === 'Legrand') return MarcaLegrand as unknown as string;
  if (nombre === 'Phoenix Contact') return MarcaPhoenix as unknown as string;
  return undefined;
}
---

<ul class="marcas" aria-label="Marcas que integramos">
  {MARCAS.map((marca) => {
    const logoSrc = getLogoSrc(marca.nombre);

    return (
      <li class="marca-item">
        {logoSrc ? (
          <img src={logoSrc} alt={marca.nombre} class="marca-logo" />
        ) : (
          <span class="marca-texto">{marca.nombre}</span>
        )}
      </li>
    );
  })}
</ul>

<style>
  .marcas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 767px) {
    .marcas {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .marca-item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3rem;
  }

  .marca-logo {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(100%) opacity(0.6);
  }

  .marca-texto {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #586A78;
    text-align: center;
  }
</style>

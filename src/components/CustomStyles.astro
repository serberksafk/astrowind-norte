---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-plex-sans` / `--font-plex-mono`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-plex-sans);
    --aw-font-serif: var(--font-plex-sans);
    --aw-font-heading: var(--font-plex-sans);

    --aw-color-primary: rgb(16 31 44);
    --aw-color-secondary: rgb(21 44 61);
    --aw-color-accent: rgb(255 203 8);

    --aw-color-text-heading: rgb(21 44 61);
    --aw-color-text-default: rgb(21 44 61);
    --aw-color-text-muted: rgb(88 106 120);
    --aw-color-bg-page: rgb(243 246 248);

    --aw-color-bg-page-dark: rgb(16 31 44);

    ::selection {
      background-color: rgb(255 203 8 / 40%);
    }
  }

</style>

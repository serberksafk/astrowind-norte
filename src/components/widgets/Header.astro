---
import { Icon } from 'astro-icon/components';
import ToggleMenu from '~/components/common/ToggleMenu.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

const isActive = (href?: string) => typeof href === 'string' && `/${trimSlash(href)}` === currentPath;

const persistKey = `header-${Array.from(
  JSON.stringify({ links, actions, isSticky, isDark, isFullWidth, showToggleTheme, showRssFeed, position })
)
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
---

<aw-header transition:persist={persistKey}>
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky },
      'top-0 z-40 flex-none mx-auto w-full bg-noche transition-[opacity] ease-in-out h-16',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div
      class:list={[
        'relative text-white h-full px-4 lg:px-6 mx-auto w-full',
        {
          'lg:flex lg:justify-between': position !== 'center',
        },
        {
          'lg:grid lg:grid-cols-3 lg:items-center': position === 'center',
        },
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between items-center w-full lg:w-auto h-16']}>
        <a class="flex items-center" href={getHomePermalink()}>
          <img
            src="/logo/TLT_H_Diapo.png"
            alt="Telectrich"
            width="134"
            height="32"
            class="h-8 w-auto"
          />
        </a>
        <div class="flex items-center gap-3 lg:hidden">
          {actions?.length ? (
            actions.map((btnProps) => (
              <a
                href={btnProps.href}
                class="inline-flex items-center justify-center h-11 px-4 bg-acento text-noche font-semibold text-sm rounded-md"
              >
                {btnProps.text}
              </a>
            ))
          ) : ''}
          <button
            type="button"
            class="flex items-center justify-center w-11 h-11 text-white"
            aria-label="Abrir menú"
            data-aw-toggle-menu
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
      <nav
        class="hidden lg:flex items-center w-full lg:w-auto lg:mx-5 lg:justify-self-center"
        aria-label="Main navigation"
      >
        <ul
          class="flex flex-row lg:self-center w-full lg:w-auto text-[0.9375rem] tracking-[0.01rem] font-medium lg:justify-center"
        >
          {
            links.map(({ text, href, links }) => (
              <li class={links?.length ? 'dropdown relative' : ''}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class="hover:text-acento px-4 py-3 flex items-center whitespace-nowrap text-white"
                    >
                      {text}{' '}
                      <Icon
                        name="tabler:chevron-down"
                        class="w-3.5 h-3.5 ml-0.5"
                      />
                    </button>
                    <ul class="dropdown-menu lg:absolute pl-4 lg:pl-0 lg:hidden font-medium lg:bg-noche-2 lg:min-w-[200px] drop-shadow-xl lg:rounded-md lg:border lg:border-white/10">
                      {links.map(({ text: text2, href: href2 }) => (
                        <li>
                          <a
                            class:list={[
                              'first:rounded-t last:rounded-b lg:hover:bg-white/10 py-2 px-5 block whitespace-nowrap text-white',
                              { 'aw-link-active text-acento': isActive(href2) },
                            ]}
                            href={href2}
                          >
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'hover:text-acento px-4 py-3 flex items-center whitespace-nowrap text-white',
                      { 'aw-link-active text-acento': isActive(href) },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div
        class:list={[
          { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
          'hidden lg:flex items-center lg:mb-0 fixed w-full lg:w-auto lg:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 lg:p-0 lg:justify-self-end',
        ]}
      >
        <div class="items-center flex justify-end w-full lg:w-auto">
          {
            actions?.length ? (
              <span class="ml-4 rtl:ml-0 rtl:mr-4">
                {actions.map((btnProps) => (
                  <a
                    href={btnProps.href}
                    class="inline-flex items-center justify-center h-11 px-6 bg-acento text-noche font-semibold text-sm rounded-md transition-colors hover:bg-acento/90"
                  >
                    {btnProps.text}
                  </a>
                ))}
              </span>
            ) : (
              ''
            )
          }
        </div>
      </div>
    </div>

    <nav
      id="mobile-menu"
      class="lg:hidden fixed inset-0 top-16 bg-noche hidden flex-col items-center justify-center gap-4"
      aria-label="Mobile navigation"
    >
      <ul class="flex flex-col items-center gap-2 text-xl font-medium">
        {
          links.map(({ text, href, links }) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-acento px-4 py-3 flex items-center whitespace-nowrap text-white"
                  >
                    {text}
                  </button>
                  <ul class="dropdown-menu pl-4">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'hover:text-acento py-2 px-5 block whitespace-nowrap text-white',
                            { 'aw-link-active text-acento': isActive(href2) },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-acento px-4 py-3 flex items-center whitespace-nowrap text-white',
                    { 'aw-link-active text-acento': isActive(href) },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      {
        actions?.length ? (
          <div class="flex flex-col gap-3 mt-4 w-48">
            {actions.map((btnProps) => (
              <a
                href={btnProps.href}
                class="inline-flex items-center justify-center h-12 px-6 bg-acento text-noche font-semibold text-sm rounded-md"
              >
                {btnProps.text}
              </a>
            ))}
          </div>
        ) : (
          ''
        )
      }
    </nav>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }

  #mobile-menu {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.2s ease-out;
  }

  #mobile-menu:not(.hidden) {
    clip-path: inset(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu {
      transition: none;
    }
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const mobileMenu = this.querySelector<HTMLElement>('#mobile-menu');

      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        mobileMenu?.classList.add('hidden');
        mobileMenu?.classList.remove('flex');
      };

      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden');
        mobileMenu?.classList.toggle('hidden');
        mobileMenu?.classList.toggle('flex');
      });

      mobileMenu?.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest('a');
        if (link) {
          closeMenu();
        }
      });

      this.mql = window.matchMedia('(min-width: 1024px)');
      this.onMqlChange = () => {
        if (this.mql && this.mql.matches) closeMenu();
      };
      this.mql.addEventListener('change', this.onMqlChange);

      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      document.removeEventListener('astro:page-load', this.onPageLoad);
    }

    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href], #mobile-menu a[href]').forEach((a) => {
        const url = new URL(a.href, window.location.href);
        const isPathLink =
          url.origin === window.location.origin && !url.hash && !a.getAttribute('href')?.startsWith('#');
        a.classList.toggle('aw-link-active', isPathLink && norm(url.pathname) === current);
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>

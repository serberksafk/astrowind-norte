---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class="relative bg-noche-2 text-white not-prose">
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 py-8 md:py-12"
  >
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-2">
          <a class="inline-block font-bold text-xl text-white" href={getHomePermalink()}>{SITE?.name}</a>
        </div>
        <div class="text-sm text-white/70 flex flex-wrap gap-x-4 gap-y-1">
          {
            secondaryLinks.map(({ text, href }, index) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a
                  class="hover:text-white transition duration-150 ease-in-out"
                  href={href}
                >
                  {text}
                </a>
              </>
            ))
          }
          <span> · </span>
          <a
            href="/privacidad/#cookies"
            class="hover:text-white transition duration-150 ease-in-out"
          >
            Preferencias de cookies
          </a>
        </div>
        <div class="mt-4 text-sm text-white/70">
          <a
            href="mailto:ventas@atingenieria.com"
            class="hover:text-white transition duration-150 ease-in-out"
          >
            ventas@atingenieria.com
          </a>
          <span class="mx-2">·</span>
          <a
            href="tel:+56935935595"
            class="hover:text-white transition duration-150 ease-in-out"
          >
            +56 9 3593 5595
          </a>
        </div>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="text-white font-medium mb-2">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm">
                {links.map(({ text, href, ariaLabel }) => (
                  <li class="mb-2">
                    <a
                      class="text-white/70 hover:text-white transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8 border-t border-white/10">
      {
        socialLinks?.length ? (
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-white/70 hover:text-white focus:outline-none focus:ring-4 focus:ring-white/20 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }

      <div class="text-sm text-white/70">
        <p class="mb-1">{footNote}</p>
        <p class="text-xs text-white/50 mb-2">AT Ingeniería SpA · RUT 76.303.133-0</p>
        <p class="text-xs text-white/40">Diseñado con amor por Norte Studio</p>
      </div>
    </div>
  </div>
</footer>
